<% content_for :title, "Sign in | Second Breakfast" %>

<section class="mx-auto w-full max-w-sm">
  <h1 class="text-2xl font-bold tracking-tight text-gray-900">Sign in to Second Breakfast</h1>

  <div class="mt-8">
    <%= form_with(url: session_path, local: true, class: "space-y-6") do |form| %>
      <div>
        <%= form.label :email, "Email address", class: "block text-sm/6 font-medium text-gray-900" %>
        <div class="mt-2">
          <%= form.email_field :email, autocomplete: "email", required: true, class: "block w-full rounded-md bg-white px-3 py-2 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-400 placeholder:text-gray-500 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-700 sm:text-sm/6" %>
        </div>
      </div>

      <div>
        <div class="flex items-center justify-between">
          <%= form.label :password, class: "block text-sm/6 font-medium text-gray-900" %>
          <%= link_to "Forgot your password?", new_password_reset_path, class: "text-sm/6 font-semibold text-indigo-600 hover:text-indigo-500" %>
        </div>
        <div class="mt-2">
          <%= form.password_field :password, autocomplete: "current-password", required: true, class: "block w-full rounded-md bg-white px-3 py-2 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-400 placeholder:text-gray-500 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-700 sm:text-sm/6" %>
        </div>
      </div>

      <div class="flex items-center gap-x-2">
        <%= form.check_box :remember_me, class: "size-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" %>
        <%= form.label :remember_me, "Remember me on this device", class: "block text-sm/6 text-gray-900" %>
      </div>

      <div>
        <%= form.submit "Sign in", class: "flex min-h-11 w-full cursor-pointer justify-center rounded-md bg-indigo-600 px-3 py-2 text-sm/6 font-semibold text-white shadow-sm hover:bg-indigo-700" %>
      </div>
    <% end %>

    <p class="mt-10 text-center text-sm/6 text-gray-500">
      No account yet?
      <%= link_to "Sign up", new_user_path, class: "font-semibold text-indigo-600 hover:text-indigo-500" %>
    </p>
  </div>
</section>
