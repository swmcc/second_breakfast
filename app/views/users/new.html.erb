<% content_for :title, "Sign up | Second Breakfast" %>

<div class="sm:mx-auto sm:w-full sm:max-w-sm">
  <h1 class="text-center text-2xl/9 font-bold tracking-tight text-gray-900">Sign Up</h1>
  <p class="mt-2 text-center text-sm/6 text-gray-500">
    We'll email you a link to confirm your address.
  </p>

  <%= render "shared/auth_flash" %>

  <div class="mt-10">
    <%= form_with(model: @user, local: true, class: "space-y-6") do |form| %>
      <% if @user.errors.any? %>
        <div id="error_explanation" class="rounded-md border border-red-200 bg-red-50 p-4">
          <h2 class="text-sm font-medium text-red-800"><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</h2>
          <ul class="mt-2 list-disc pl-5 text-sm text-red-700">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :email, "Email address", class: "block text-sm/6 font-medium text-gray-900" %>
        <div class="mt-2">
          <%= form.email_field :email, autocomplete: "email", required: true, class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
        </div>
      </div>

      <div>
        <%= form.label :password, class: "block text-sm/6 font-medium text-gray-900" %>
        <div class="mt-2">
          <%= form.password_field :password, autocomplete: "new-password", required: true, minlength: User::MINIMUM_PASSWORD_LENGTH, class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
        </div>
        <p class="mt-1 text-xs text-gray-500">At least <%= User::MINIMUM_PASSWORD_LENGTH %> characters.</p>
      </div>

      <div>
        <%= form.label :password_confirmation, class: "block text-sm/6 font-medium text-gray-900" %>
        <div class="mt-2">
          <%= form.password_field :password_confirmation, autocomplete: "new-password", required: true, minlength: User::MINIMUM_PASSWORD_LENGTH, class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
        </div>
      </div>

      <div>
        <%= form.submit "Sign Up", class: "flex w-full justify-center rounded-md bg-indigo-600 px-3 py-1.5 text-sm/6 font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
      </div>
    <% end %>

    <p class="mt-10 text-center text-sm/6 text-gray-500">
      Already have an account?
      <%= link_to "Sign in", sign_in_path, class: "font-semibold text-indigo-600 hover:text-indigo-500" %>
    </p>
  </div>
</div>
