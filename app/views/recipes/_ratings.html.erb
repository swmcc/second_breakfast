<% average = formatted_average_rating(recipe) %>
<% count = recipe.ratings_count %>
<% own_rating = signed_in? ? recipe.rating_by(current_user) : nil %>

<section class="rounded-lg bg-white shadow p-6" aria-labelledby="ratings-heading">
  <h3 id="ratings-heading" class="text-xl font-semibold text-gray-900">Ratings</h3>

  <p class="mt-2 text-gray-600" id="average-rating">
    <% if average %>
      <span class="text-2xl font-semibold text-gray-900"><%= average %></span>
      <span class="text-sm">out of 5 &middot; <%= pluralize(count, "rating") %></span>
    <% else %>
      <span class="text-sm">No ratings yet.</span>
    <% end %>
  </p>

  <% if signed_in? %>
    <div class="mt-4 print:hidden">
      <%= form_with url: recipe_rating_path(recipe),
                    method: :post,
                    data: { controller: "rating", action: "mouseleave->rating#reset" },
                    class: "flex flex-wrap items-center gap-3" do %>
        <fieldset class="flex items-center gap-1">
          <legend class="sr-only">Your rating</legend>
          <% Rating::VALUES.each do |value| %>
            <label class="cursor-pointer"
                   data-rating-target="star"
                   data-rating-value="<%= value %>"
                   data-action="mouseenter->rating#preview"
                   title="<%= pluralize(value, "star") %>">
              <%= radio_button_tag "rating[value]", value, own_rating&.value == value,
                    class: "sr-only",
                    data: { rating_target: "input", action: "change->rating#submit" } %>
              <span class="sr-only"><%= pluralize(value, "star") %></span>
              <svg class="w-8 h-8 <%= (own_rating && value <= own_rating.value) ? "text-yellow-400" : "text-gray-300" %>"
                   fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.958a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.367 2.446a1 1 0 00-.363 1.118l1.285 3.958c.3.921-.755 1.688-1.539 1.118l-3.366-2.446a1 1 0 00-1.176 0l-3.366 2.446c-.784.57-1.838-.197-1.539-1.118l1.285-3.958a1 1 0 00-.363-1.118L2.06 9.385c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.951-.69l1.286-3.958z" />
              </svg>
            </label>
          <% end %>
        </fieldset>

        <%= submit_tag own_rating ? "Update rating" : "Rate this recipe",
              data: { rating_target: "submit" },
              class: "rounded-md px-3.5 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-sm cursor-pointer" %>
      <% end %>

      <% if own_rating %>
        <%= button_to "Remove my rating", recipe_rating_path(recipe),
              method: :delete,
              class: "mt-3 text-sm text-gray-500 hover:text-gray-700 underline" %>
      <% end %>
    </div>
  <% else %>
    <p class="mt-4 text-sm text-gray-500 print:hidden">
      <%= link_to "Sign in", sign_in_path, class: "text-indigo-600 hover:text-indigo-500 underline" %>
      to rate this recipe.
    </p>
  <% end %>
</section>
