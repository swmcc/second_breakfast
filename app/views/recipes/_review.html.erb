<li id="<%= dom_id review %>" class="rounded-lg bg-gray-50 p-4">
  <div class="flex items-baseline justify-between gap-4">
    <p class="text-sm font-medium text-gray-900"><%= review.user.email %></p>
    <p class="text-xs text-gray-500"><%= l review.created_at, format: :long %></p>
  </div>

  <p class="mt-2 text-gray-700 whitespace-pre-line"><%= review.body %></p>

  <% if signed_in? && review.editable_by?(current_user) %>
    <div class="mt-3 flex gap-3 print:hidden">
      <%= link_to "Edit", edit_recipe_review_path(recipe, review),
            class: "text-sm text-indigo-600 hover:text-indigo-500 underline" %>
      <%= button_to "Delete", recipe_review_path(recipe, review),
            method: :delete,
            form: { data: { turbo_confirm: "Delete this review?" } },
            class: "text-sm text-red-600 hover:text-red-500 underline" %>
    </div>
  <% end %>
</li>
