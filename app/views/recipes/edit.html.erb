<% content_for :title, "Editing recipe" %>
<% breadcrumbs [ "Recipes", recipes_path ], [ @recipe.title, recipe_path(@recipe) ], [ "Edit" ] %>

<div class="w-full max-w-3xl">
  <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Editing recipe</h1>

  <%= render "form", recipe: @recipe %>

  <%= link_to "Show this recipe", @recipe, class: "mt-4 mr-2 rounded-md px-3.5 py-2.5 min-h-11 bg-gray-100 hover:bg-gray-200 text-gray-800 inline-flex items-center font-medium" %>
  <%= link_to "Back to recipes", recipes_path, class: "mt-4 mr-2 rounded-md px-3.5 py-2.5 min-h-11 bg-gray-100 hover:bg-gray-200 text-gray-800 inline-flex items-center font-medium" %>
</div>
