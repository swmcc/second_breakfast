<% content_for :title, "Showing recipe" %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <%= render @recipe %>

  <div class="flex flex-wrap gap-4 mt-6">
  <% if signed_in? %>
    <% basket = current_user.baskets.find_by(recipe: @recipe) %>

    <% if basket %>
      <%= button_to toggle_meal_path(recipe_id: @recipe.id),
          method: :post,
          class: "rounded-md px-3.5 py-2.5 bg-green-500 hover:bg-green-400 text-white font-medium inline-flex items-center" do %>
        <span>In Meal Plan</span>
      <% end %>
    <% else %>
      <%= button_to toggle_meal_path(recipe_id: @recipe.id),
          method: :post,
          class: "rounded-md px-3.5 py-2.5 bg-blue-500 hover:bg-blue-400 text-white font-medium inline-flex items-center" do %>
        <span>Add to Meal Plan</span>
      <% end %>
    <% end %>
  <% end %>

    <% if signed_in? %>
      <%= link_to edit_recipe_path(@recipe), class: "rounded-md px-3.5 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-medium inline-flex items-center" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        Edit Recipe
      <% end %>

      <%= button_to @recipe, method: :delete, class: "rounded-md px-3.5 py-2.5 bg-red-600 hover:bg-red-500 text-white font-medium inline-flex items-center", form: { data: { turbo_confirm: 'Are you sure?' } } do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        Delete Recipe
      <% end %>
    <% end %>

    <%= link_to recipes_path, class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 text-gray-700 font-medium inline-flex items-center" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to Recipes
    <% end %>
  </div>
</div>
