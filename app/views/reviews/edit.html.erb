<% content_for :title, "Edit review" %>

<div class="md:w-2/3 w-full">
  <h1 class="text-2xl font-bold text-gray-900">Edit your review</h1>
  <p class="mt-1 text-sm text-gray-500">on <%= link_to @recipe.title, @recipe, class: "text-indigo-600 underline" %></p>

  <%= form_with model: @review, url: recipe_review_path(@recipe, @review), method: :patch, class: "mt-6" do |form| %>
    <% if @review.errors.any? %>
      <div class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mb-4">
        <ul class="list-disc ml-6">
          <% @review.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form.text_area :body,
          rows: 6,
          maxlength: Review::MAX_BODY_LENGTH,
          class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>

    <div class="mt-4 flex gap-3">
      <%= form.submit "Update review",
            class: "rounded-md px-3.5 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-sm cursor-pointer" %>
      <%= link_to "Cancel", @recipe,
            class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium text-sm" %>
    </div>
  <% end %>
</div>
