<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Second Breakfast" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-white text-gray-900" data-controller="form-status">
    <%= render "shared/skip_link" %>

    <header class="sb-sticky-header sticky top-0 z-40 border-b border-gray-900/10 bg-white"
            data-controller="mobile-menu">
      <nav class="mx-auto flex max-w-7xl items-center justify-between gap-x-4 px-4 py-3 sm:px-6 lg:px-8"
           aria-label="Main">
        <div class="flex flex-1 items-center">
          <div class="hidden lg:flex lg:gap-x-8">
            <%= link_to "Recipes", recipes_path, class: "inline-flex min-h-11 items-center rounded-md px-1 text-sm font-semibold text-gray-900 hover:text-indigo-700 hover:underline" %>
            <%= link_to "Categories", categories_path, class: "inline-flex min-h-11 items-center rounded-md px-1 text-sm font-semibold text-gray-900 hover:text-indigo-700 hover:underline" %>
          </div>
          <div class="flex lg:hidden">
            <button type="button"
                    class="-ml-2 inline-flex h-11 w-11 items-center justify-center rounded-md text-gray-700 hover:bg-gray-100"
                    aria-controls="mobile-nav"
                    aria-expanded="false"
                    data-mobile-menu-target="trigger"
                    data-action="mobile-menu#toggle">
              <span class="sr-only">Open main menu</span>
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
              </svg>
            </button>
          </div>
        </div>

        <%= link_to root_path, class: "inline-flex h-11 w-11 items-center justify-center rounded-md" do %>
          <span class="sr-only">Second Breakfast &mdash; home</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-auto text-indigo-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <%# Outer circle (plate) %>
            <circle cx="12" cy="12" r="9" stroke="currentColor" fill="none" />
            <%# Inner circle (design detail) %>
            <circle cx="12" cy="12" r="5" stroke="currentColor" fill="none" />
          </svg>
        <% end %>

        <div class="flex flex-1 justify-end">
          <div class="flex items-center gap-x-2 sm:gap-x-4">
            <% if user_signed_in? %>
              <%# Weekly meal plan link - always visible %>
              <%= link_to meal_plans_path, class: "inline-flex min-h-11 items-center gap-x-1 rounded-md px-1 text-gray-600 hover:text-indigo-700" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                </svg>
                <span class="hidden text-sm font-medium sm:inline">Meal Plan</span>
                <span class="sr-only sm:hidden">Meal Plan</span>
              <% end %>

              <%# Saved recipes link %>
              <%= link_to meals_path, class: "inline-flex min-h-11 items-center gap-x-1 rounded-md px-1 text-gray-600 hover:text-indigo-700" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" />
                </svg>
                <span class="text-sm font-medium"><%= pluralize(current_user.baskets.count, 'Saved Recipe') %></span>
              <% end %>

              <%# User dropdown menu %>
              <div class="relative" data-controller="dropdown">
                <button type="button"
                        class="hidden min-h-11 max-w-[12rem] items-center gap-x-1 rounded-md px-1 text-sm font-semibold text-gray-900 hover:text-indigo-700 sm:inline-flex"
                        data-dropdown-target="button"
                        data-action="click->dropdown#toggle keydown->dropdown#buttonKeydown"
                        aria-expanded="false"
                        aria-haspopup="true">
                  <span class="truncate"><%= current_user.email %></span>
                  <svg class="h-4 w-4 flex-none" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                  </svg>
                </button>

                <div class="hidden absolute right-0 z-10 mt-2 w-56 origin-top-right rounded-md bg-white py-1 shadow-lg ring-1 ring-black/5"
                     data-dropdown-target="menu"
                     data-action="keydown->dropdown#menuKeydown"
                     role="menu"
                     aria-orientation="vertical">
                  <div class="border-b border-gray-200 px-4 py-2 text-sm text-gray-600">
                    Signed in as<br>
                    <span class="font-medium text-gray-900"><%= current_user.email %></span>
                  </div>
                  <%= link_to "Account", account_path,
                      class: "flex min-h-11 items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900",
                      role: "menuitem" %>
                  <%= link_to sign_out_path,
                      class: "flex min-h-11 items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900",
                      data: { turbo_method: :delete },
                      role: "menuitem" do %>
                    Sign out
                  <% end %>
                </div>
              </div>
            <% else %>
              <%= link_to "Sign In", sign_in_path,
                  class: "inline-flex min-h-11 items-center rounded-md px-1 text-sm font-semibold text-gray-900 hover:text-indigo-700 hover:underline" %>
            <% end %>
          </div>
        </div>
      </nav>

      <%= form_with url: search_recipes_path, method: :get, class: "mx-auto max-w-7xl px-4 pb-3 sm:px-6 lg:px-8" do %>
        <div class="relative mx-auto max-w-md">
          <%= label_tag :query, "Search recipes", class: "sr-only" %>
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
            <svg class="h-4 w-4 text-gray-500" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"/>
            </svg>
          </div>
          <%= search_field_tag :query, params[:query], placeholder: "Search recipes...", class: "block w-full rounded-lg border border-gray-300 bg-white p-2 pl-10 text-sm text-gray-900 placeholder:text-gray-500 focus:border-indigo-700 focus:ring-indigo-700" %>
        </div>
      <% end %>

      <%# Small-screen navigation panel. Hidden until the trigger opens it. %>
      <div id="mobile-nav"
           class="hidden lg:hidden"
           role="dialog"
           aria-modal="true"
           aria-label="Main menu"
           data-mobile-menu-target="panel"
           data-action="keydown->mobile-menu#keydown">
        <div class="fixed inset-0 z-40 bg-gray-900/20" data-action="click->mobile-menu#closeAndRefocus"></div>
        <div class="fixed inset-y-0 left-0 z-50 w-full max-w-sm overflow-y-auto bg-white px-4 py-3 shadow-xl">
          <div class="flex items-center justify-between">
            <span class="text-base font-semibold text-gray-900">Menu</span>
            <button type="button"
                    class="-mr-2 inline-flex h-11 w-11 items-center justify-center rounded-md text-gray-700 hover:bg-gray-100"
                    data-action="mobile-menu#closeAndRefocus">
              <span class="sr-only">Close menu</span>
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

          <nav class="mt-4" aria-label="Mobile">
            <ul role="list" class="space-y-1">
              <li><%= link_to "Recipes", recipes_path, class: "flex min-h-11 items-center rounded-lg px-3 text-base font-semibold text-gray-900 hover:bg-gray-100" %></li>
              <li><%= link_to "Categories", categories_path, class: "flex min-h-11 items-center rounded-lg px-3 text-base font-semibold text-gray-900 hover:bg-gray-100" %></li>
              <% if user_signed_in? %>
                <li><%= link_to "Meal Plan", meal_plans_path, class: "flex min-h-11 items-center rounded-lg px-3 text-base font-semibold text-gray-900 hover:bg-gray-100" %></li>
                <li><%= link_to "Saved Recipes", meals_path, class: "flex min-h-11 items-center rounded-lg px-3 text-base font-semibold text-gray-900 hover:bg-gray-100" %></li>
                <li><%= link_to "Account", account_path, class: "flex min-h-11 items-center rounded-lg px-3 text-base font-semibold text-gray-900 hover:bg-gray-100" %></li>
                <li><%= link_to "Sign out", sign_out_path, data: { turbo_method: :delete }, class: "flex min-h-11 items-center rounded-lg px-3 text-base font-semibold text-gray-900 hover:bg-gray-100" %></li>
              <% else %>
                <li><%= link_to "Sign In", sign_in_path, class: "flex min-h-11 items-center rounded-lg px-3 text-base font-semibold text-gray-900 hover:bg-gray-100" %></li>
              <% end %>
            </ul>
          </nav>
        </div>
      </div>
    </header>

    <main id="main-content" tabindex="-1" class="container mx-auto mt-8 flex flex-col gap-y-6 px-4 sm:px-5">
      <%= yield :breadcrumbs %>
      <%= render "shared/flashes" %>
      <%= yield %>
    </main>

    <footer class="bg-white">
      <div class="mx-auto mt-8 max-w-7xl border-t border-gray-900/10 px-4 py-8 sm:px-6 md:flex md:items-center md:justify-between lg:px-8">
        <nav class="flex flex-wrap gap-x-6 md:order-2" aria-label="Footer">
          <%= link_to "About", about_path, class: "inline-flex min-h-11 items-center text-sm text-gray-600 hover:text-gray-900 hover:underline" %>
          <%= link_to "Colophon", colophon_path, class: "inline-flex min-h-11 items-center text-sm text-gray-600 hover:text-gray-900 hover:underline" %>
          <%= link_to "Privacy", privacy_path, class: "inline-flex min-h-11 items-center text-sm text-gray-600 hover:text-gray-900 hover:underline" %>
          <%= link_to "Terms", terms_path, class: "inline-flex min-h-11 items-center text-sm text-gray-600 hover:text-gray-900 hover:underline" %>
        </nav>
        <p class="mt-4 text-sm text-gray-600 md:order-1 md:mt-0">Built with <span aria-hidden="true">&#10084;&#65039;</span><span class="sr-only">love</span> by <%= link_to "swmcc", "https://swm.cc", class: "font-medium text-gray-900 hover:text-indigo-700 hover:underline" %></p>
      </div>
    </footer>
  </body>
</html>
