<div class="w-full px-4 sm:px-6 lg:px-8 py-12">
  <div class="flex items-center">
    <div class="flex-auto">
      <h1 class="text-2xl font-semibold leading-6 text-gray-900">Your Chosen Meals</h1>
      <p class="mt-2 text-sm text-gray-700">A list of all the meals you've selected for your meal plan.</p>
    </div>
  </div>

  <div class="mt-8">
    <div class="overflow-x-auto">
      <div class="min-w-full">
        <% if current_user.baskets.any? %>
          <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg">
            <div class="divide-y divide-gray-300">
              <% current_user.baskets.each do |basket| %>
                <div class="bg-white px-6 py-5 flex justify-between items-center">
                  <div class="flex items-center gap-x-4">
                    <% if basket.recipe.image.attached? %>
                      <%= image_tag basket.recipe.image, class: "h-16 w-16 rounded-lg object-cover" %>
                    <% else %>
                      <div class="h-16 w-16 rounded-lg bg-gray-100 flex items-center justify-center">
                        <svg class="h-8 w-8 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                      </div>
                    <% end %>
                    <div>
                      <h3 class="text-lg font-medium text-gray-900"><%= basket.recipe.title %></h3>
                      <p class="mt-1 text-sm text-gray-500"><%= basket.recipe.description %></p>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% else %>
          <div class="text-center py-12">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            <h3 class="mt-2 text-sm font-medium text-gray-900">No meals in your basket</h3>
            <p class="mt-1 text-sm text-gray-500">Get started by adding some recipes to your meal plan.</p>
            <div class="mt-6">
              <%= link_to recipes_path, class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" do %>
                Browse Recipes
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>