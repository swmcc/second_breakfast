<%= form_with(model: category, class: "contents") do |form| %>
  <%= render "shared/error_summary", object: category, noun: "category" %>

  <div class="my-5">
    <%= form.label :name, class: "block text-sm font-medium text-gray-900" %>
    <%= form.text_field :name, class: "block shadow rounded-md border px-3 py-2 mt-2 w-full #{field_border_classes(category, :name)}", **field_error_attributes(category, :name) %>
    <%= render "shared/field_error", object: category, attribute: :name %>
  </div>

  <div class="inline">
    <%= form.submit class: "rounded-md px-3.5 py-2.5 min-h-11 bg-blue-600 hover:bg-blue-700 text-white inline-flex items-center font-medium cursor-pointer" %>
  </div>
<% end %>
