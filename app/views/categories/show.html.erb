<% content_for :title, "#{@category.name} | Second Breakfast" %>
<% breadcrumbs [ "Categories", categories_path ], [ @category.name ] %>

<div class="w-full max-w-3xl">
  <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"><%= @category.name %></h1>

  <%= render @category %>

  <div class="flex flex-wrap gap-3 mt-6" role="group" aria-label="Category actions">
    <% if signed_in? %>
      <%= link_to edit_category_path(@category), class: "rounded-md px-3.5 py-2.5 min-h-11 bg-indigo-600 hover:bg-indigo-700 text-white font-medium inline-flex items-center" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        Edit Category
      <% end %>

      <%= button_to @category, method: :delete, class: "rounded-md px-3.5 py-2.5 min-h-11 bg-red-600 hover:bg-red-700 text-white font-medium inline-flex items-center", form: { data: { turbo_confirm: 'Are you sure?' } } do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        Delete Category
      <% end %>
    <% end %>

    <%= link_to categories_path, class: "rounded-md px-3.5 py-2.5 min-h-11 bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium inline-flex items-center" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to Categories
    <% end %>
  </div>
</div>
