<%# Inline error message for a single field. Locals: object, attribute. %>
<%# Its id is what the field points at with aria-describedby -- see %>
<%# ApplicationHelper#field_error_attributes. %>
<% messages = object.errors.full_messages_for(attribute) %>
<% if messages.any? %>
  <p class="mt-1 flex items-start gap-x-1 text-sm text-red-800"
     id="<%= field_error_dom_id(object, attribute) %>">
    <svg class="mt-0.5 h-4 w-4 flex-none" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
    </svg>
    <span><%= messages.to_sentence %></span>
  </p>
<% end %>
