<%#
  Application-wide flash rendering.

  Only the keys listed in FLASH_STYLES are rendered here; the app also stashes
  non-message values in the flash (e.g. flash[:new_api_key_token]) which must
  never be printed as a notification.

  Successes announce politely via role="status"; failures interrupt via
  role="alert". Successes also fade themselves out, failures do not.
%>
<%
  flash_styles = {
    "notice"  => { classes: "bg-green-50 text-green-800 ring-green-700/30", role: "status", icon: :check,   label: "Success", auto: true },
    "success" => { classes: "bg-green-50 text-green-800 ring-green-700/30", role: "status", icon: :check,   label: "Success", auto: true },
    "alert"   => { classes: "bg-red-50 text-red-800 ring-red-700/30",       role: "alert",  icon: :warning, label: "Error",   auto: false },
    "error"   => { classes: "bg-red-50 text-red-800 ring-red-700/30",       role: "alert",  icon: :warning, label: "Error",   auto: false },
    "warning" => { classes: "bg-amber-50 text-amber-800 ring-amber-700/30", role: "status", icon: :warning, label: "Warning", auto: false }
  }
  messages = flash.to_h.slice(*flash_styles.keys).reject { |_key, value| value.blank? }
%>
<% if messages.any? %>
  <div class="space-y-3" id="flash-messages">
    <% messages.each do |key, message| %>
      <% style = flash_styles.fetch(key) %>
      <div class="relative flex items-start gap-x-3 rounded-lg px-4 py-3 pr-12 text-sm font-medium ring-1 ring-inset <%= style[:classes] %>"
           role="<%= style[:role] %>"
           data-flash-kind="<%= key %>"
           data-controller="flash"
           <%= "data-flash-auto-dismiss-value=true" if style[:auto] %>>
        <% if style[:icon] == :check %>
          <svg class="mt-0.5 h-5 w-5 flex-none" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
          </svg>
        <% else %>
          <svg class="mt-0.5 h-5 w-5 flex-none" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
          </svg>
        <% end %>

        <p class="min-w-0 flex-1 break-words">
          <span class="sr-only"><%= style[:label] %>:</span>
          <%= message %>
        </p>

        <button type="button"
                class="absolute right-1 top-1 inline-flex h-11 w-11 items-center justify-center rounded-md text-current opacity-70 hover:opacity-100 focus-visible:opacity-100"
                data-action="flash#dismiss">
          <span class="sr-only">Dismiss <%= style[:label].downcase %> notification</span>
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" />
          </svg>
        </button>
      </div>
    <% end %>
  </div>
<% end %>
